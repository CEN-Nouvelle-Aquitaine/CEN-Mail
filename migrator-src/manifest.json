{
  "manifest_version": 3,
  "name": "Mail-Migrator CEN",
  "version": "1.7.0",
  "description": "Migration dossiers locaux → compte Outlook monté dans Thunderbird (dates préservées via copie native)",
  "author": "DSI CEN Nouvelle-Aquitaine",
  "browser_specific_settings": {
    "gecko": {
      "id": "mail-migrator@cen-na.org",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "accountsRead",
    "accountsFolders",
    "messagesRead",
    "messagesMove",
    "storage"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Mail-Migrator CEN",
    "default_popup": "popup/popup.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "64": "icons/icon-64.png"
  }
}
